{
  "info": {
    "name": "LOCi Mobile API v1",
    "description": "React Native / Expo integration for LOCi. Set baseUrl and username/password, run Login, then use the saved accessToken as a Bearer token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "username", "value": "" },
    { "key": "password", "value": "" },
    { "key": "accessToken", "value": "" },
    { "key": "contactId", "value": "" }
  ],
  "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
  "item": [
    { "name": "Authentication", "item": [
      { "name": "Login", "request": { "auth": { "type": "noauth" }, "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}" }, "url": "{{baseUrl}}/api/mobile/v1/auth/login" }, "event": [{ "listen": "test", "script": { "exec": ["const body = pm.response.json();", "if (body.data?.accessToken) pm.collectionVariables.set('accessToken', body.data.accessToken);"] } }] },
      { "name": "Refresh token", "request": { "method": "POST", "url": "{{baseUrl}}/api/mobile/v1/auth/refresh" } },
      { "name": "Logout", "request": { "method": "POST", "url": "{{baseUrl}}/api/mobile/v1/auth/logout" } },
      { "name": "Request password reset", "request": { "auth": { "type": "noauth" }, "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{username}}\",\n  \"channel\": \"EMAIL\"\n}" }, "url": "{{baseUrl}}/api/mobile/v1/auth/password-reset" } },
      { "name": "Complete password reset", "request": { "auth": { "type": "noauth" }, "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{username}}\",\n  \"token\": \"paste-reset-token\",\n  \"password\": \"new-password-123\"\n}" }, "url": "{{baseUrl}}/api/mobile/v1/auth/password-reset?action=complete" } }
    ]},
    { "name": "Account and dashboard", "item": [
      { "name": "My profile", "request": { "method": "GET", "url": "{{baseUrl}}/api/mobile/v1/me" } },
      { "name": "Dashboard summary", "request": { "method": "GET", "url": "{{baseUrl}}/api/mobile/v1/dashboard" } },
      { "name": "Phone numbers", "request": { "method": "GET", "url": "{{baseUrl}}/api/mobile/v1/phone-numbers" } }
    ]},
    { "name": "Messaging and contacts", "item": [
      { "name": "Contacts", "request": { "method": "GET", "url": "{{baseUrl}}/api/mobile/v1/contacts?page=1&limit=25&q=" } },
      { "name": "Conversations", "request": { "method": "GET", "url": "{{baseUrl}}/api/mobile/v1/conversations?page=1&limit=25" } },
      { "name": "Conversation messages", "request": { "method": "GET", "url": "{{baseUrl}}/api/mobile/v1/conversations/{{contactId}}/messages?page=1&limit=50" } },
      { "name": "All messages", "request": { "method": "GET", "url": "{{baseUrl}}/api/mobile/v1/messages?page=1&limit=25" } },
      { "name": "Send WhatsApp message", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"messaging_product\": \"whatsapp\",\n  \"recipient_type\": \"individual\",\n  \"to\": \"254700000000\",\n  \"type\": \"text\",\n  \"text\": { \"body\": \"Hello from LOCi mobile\" }\n}" }, "url": "{{baseUrl}}/api/mobile/v1/messages" } }
    ]},
    { "name": "Commerce", "item": [
      { "name": "Products", "request": { "method": "GET", "url": "{{baseUrl}}/api/mobile/v1/products?page=1&limit=25" } },
      { "name": "Orders", "request": { "method": "GET", "url": "{{baseUrl}}/api/mobile/v1/orders?page=1&limit=25" } }
    ]}
  ]
}
