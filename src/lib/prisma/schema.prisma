generator client {
  provider = "prisma-client-js"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum CommunicationChannel {
  WHATSAPP
  SMS
  EMAIL
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String?    @unique
  emailVerified DateTime?
  tel           String?    @unique
  telVerified   DateTime?
  image         String?
  password      String?
  role          UserRole   @default(USER)
  status        UserStatus @default(ACTIVE)

  username String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  preferredCommunicationChannel CommunicationChannel @default(WHATSAPP)

  waba WabaAccount?

  contacts             Contact[]
  messages             Message[]
  subscriptions        Subscription[]
  tokens               Token[]
  autoreplyRules       AutoReplyRule[]
  wabaTemplates        WabaTemplate[]
  promptTemplates      PromptTemplate[]
  products             Product[]
  orders               Order[]
  invoices             Invoice[]
  payouts              OrderPayout[]
  whatsappCampaigns    WhatsAppCampaign[]
  inventoryAdjustments InventoryAdjustment[]
  agentRuns            AgentRun[]
  messageQuotas        MessageQuota[]

  paystackRecipientCode     String?
  paystackRecipientCurrency Currency?

  @@map("users")
}

enum TokenType {
  SIGN_IN
  RESET
  ONBOARDING
  API_KEY
}

model Token {
  id          String               @id @default(cuid())
  type        TokenType
  hashedToken String
  expiresAt   DateTime             @map("expires_at")
  channel     NotificationChannel?
  description String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  isActive   Boolean   @default(true) @map("is_active")
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@unique([type, userId])
  @@index([type, hashedToken])
  @@map("auth_tokens")
}

enum PlanName {
  BASIC
  STANDARD
  PREMIUM
}

enum PlanInterval {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  INCOMPLETE // Created but payment pending
  ACTIVE // Active and paid
  PAST_DUE // Payment failed on renewal
  CANCELED // Canceled, but retains access until period ends
  EXPIRED // Period ended without renewal
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum PaymentMethod {
  PAYSTACK
  MPESA
  CARD
  BANK
}

enum FulfillmentStatus {
  UNFULFILLED
  PROCESSING
  SHIPPED
  DELIVERED
  DISPUTED
  CANCELLED
}

enum PayoutStatus {
  NOT_DUE
  QUEUED
  PENDING
  PAID
  FAILED
  REVERSED
  ON_HOLD
}

enum LedgerTransactionType {
  PAYMENT_RECEIVED
  PAYOUT_SENT
  REFUND_ISSUED
  PAYOUT_REVERSED
}

enum LedgerAccount {
  PAYMENT_CLEARING
  SELLER_PAYABLE
  PLATFORM_REVENUE
  REFUND_CLEARING
}

enum LedgerSide {
  DEBIT
  CREDIT
}

model Plan {
  id                  String         @id @default(cuid())
  name                PlanName       @unique
  description         String?
  monthlyPrice        Int
  maxPhoneNumbers     Int
  maxMessagesPerMonth Int
  maxTemplates        Int            @default(3)
  active              Boolean        @default(true)
  popular             Boolean        @default(false)
  subscriptions       Subscription[]

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  planFeatures PlanFeature[]

  @@map("plans")
}

model Subscription {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  planId String
  plan   Plan   @relation(fields: [planId], references: [id])

  status   SubscriptionStatus @default(INCOMPLETE)
  interval PlanInterval       @default(MONTHLY)

  // Explicit tracking dates
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean   @default(false)
  canceledAt         DateTime?

  payments SubscriptionPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@map("subscriptions")
}

model SubscriptionPayment {
  id            String        @id @default(cuid())
  transactionId String        @unique
  paymentMethod PaymentMethod

  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  amount   Decimal       @db.Decimal(10, 2)
  currency Currency      @default(KES)
  status   PaymentStatus @default(PENDING)

  paidAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subscription_payments")
}

enum WabaOwnership {
  OWNED
  SHARED
}

model WabaAccount {
  id        String        @id @unique
  name      String
  userId    String?       @unique
  user      User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  ownership WabaOwnership

  currency                 String?
  timezoneId               String?
  messageTemplateNamespace String?
  accessTokenEncrypted     String?   @db.Text
  accessTokenType          String?
  accessTokenExpiresAt     DateTime?
  tokenUpdatedAt           DateTime?
  businessId               String?

  phoneNumbers PhoneNumber[]
  templates    WabaTemplate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("waba_accounts")
}

model WabaTemplate {
  id             String                 @id @default(cuid())
  name           String
  status         TemplateApprovalStatus
  category       TemplateCategory
  language       TemplateLanguage       @default(en_US)
  components     Json
  rejectedReason String?

  wabaId String
  waba   WabaAccount @relation(fields: [wabaId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: Cascade)

  createdAt DateTime?          @default(now())
  updatedAt DateTime           @updatedAt
  campaigns WhatsAppCampaign[]

  @@unique([name, wabaId])
  @@index([status])
  @@index([category])
  @@map("waba_templates")
}

/// Admin-curated templates users can instantiate for their own WABA.
model TemplateLibraryEntry {
  id          String           @id @default(cuid())
  key         String           @unique
  name        String
  description String?
  category    TemplateCategory
  language    TemplateLanguage @default(en_US)
  components  Json
  isDefault   Boolean          @default(false)
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([isActive, isDefault])
  @@map("template_library_entries")
}

enum WhatsAppCampaignStatus {
  SCHEDULED
  PROCESSING
  SENT
  PARTIAL
  FAILED
  CANCELLED
}

enum WhatsAppCampaignRecipientStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

model WhatsAppCampaign {
  id             String                 @id @default(cuid())
  userId         String
  phoneNumberId  String
  templateId     String?
  name           String
  language       String                 @default("en_US")
  bodyParameters String[]               @default([])
  status         WhatsAppCampaignStatus @default(SCHEDULED)
  scheduledAt    DateTime
  completedAt    DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  user        User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  phoneNumber PhoneNumber                 @relation(fields: [phoneNumberId], references: [id], onDelete: Cascade)
  template    WabaTemplate?               @relation(fields: [templateId], references: [id], onDelete: SetNull)
  recipients  WhatsAppCampaignRecipient[]

  @@index([status, scheduledAt])
  @@index([userId, createdAt(sort: Desc)])
  @@map("whatsapp_campaigns")
}

model WhatsAppCampaignRecipient {
  id                String                          @id @default(cuid())
  campaignId        String
  contactId         String
  status            WhatsAppCampaignRecipientStatus @default(PENDING)
  providerMessageId String?                         @unique
  error             String?
  sentAt            DateTime?
  createdAt         DateTime                        @default(now())
  updatedAt         DateTime                        @updatedAt

  campaign WhatsAppCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact  Contact          @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([campaignId, contactId])
  @@index([campaignId, status])
  @@map("whatsapp_campaign_recipients")
}

enum TemplateLanguage {
  en_US
  en_GB
  fr_FR
  sw_KE
}

enum TemplateCategory {
  AUTHENTICATION
  UTILITY
  MARKETING
}

enum TemplateApprovalStatus {
  APPROVED
  PENDING
  REJECTED
  DISABLED
  PAUSED
  IN_APPEAL
  PENDING_DELETION
  DELETED
  LIMIT_EXCEEDED
  ARCHIVED
  FLAGGED
}

enum NotificationChannel {
  EMAIL
  WHATSAPP
  SMS
}

model Payment {
  id            String        @id @default(cuid())
  transactionId String        @unique
  paymentMethod PaymentMethod

  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  amount   Decimal       @db.Decimal(10, 2)
  currency Currency      @default(KES)
  status   PaymentStatus @default(PENDING)

  paidAt   DateTime?
  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payments")
}

enum Currency {
  KES
  USD
}

model Feature {
  id          String        @id @default(cuid())
  name        String        @unique
  description String
  useMetric   String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  plans       PlanFeature[]

  @@map("features")
}

model PlanFeature {
  planId      String
  featureId   String
  enabled     Boolean  @default(true)
  limitUse    Int?
  configValue String?
  createdAt   DateTime @default(now())
  feature     Feature  @relation(fields: [featureId], references: [id], onDelete: Cascade)
  plan        Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@id([planId, featureId])
  @@map("plan_features")
}

model PhoneNumber {
  id                  String  @id @default(cuid())
  phoneNumber         String  @unique
  displayName         String?
  preVerificationId   String?
  preVerificationCode String?

  status                     PhoneNumberStatus @default(NOT_CLAIMED)
  verifiedAt                 DateTime?
  whatsappRegistrationStatus String?
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt

  messages          Message[]
  autoReplyRules    AutoReplyRule[]
  whatsappCampaigns WhatsAppCampaign[]
  agentRuns         AgentRun[]

  wabaId String?
  waba   WabaAccount? @relation(fields: [wabaId], references: [id], onDelete: Restrict)

  chatbotConfig ChatbotConfig?

  @@map("phone_numbers")
}

model Contact {
  id          String @id @default(cuid())
  phoneNumber String

  name                String?
  avatar              String?
  whatsappOptInAt     DateTime?
  whatsappOptInSource String?
  whatsappOptOutAt    DateTime?
  lastMessageAt       DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  messages                   Message[]
  chatbotConversations       ChatbotConversation[]
  orders                     Order[]
  whatsappCampaignRecipients WhatsAppCampaignRecipient[]
  agentRuns                  AgentRun[]

  @@unique([userId, phoneNumber])
  @@index([userId, lastMessageAt(sort: Desc)])
  @@map("contacts")
}

model Message {
  id                 String           @id @default(cuid())
  userId             String
  contactId          String
  phoneNumberId      String
  waMessageId        String?
  astMessageId       String?
  replyToWaMessageId String?          @unique
  type               MessageType      @default(TEXT)
  content            Json
  direction          MessageDirection
  status             MessageStatus    @default(SENT)
  timestamp          DateTime
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  contact            Contact          @relation(fields: [contactId], references: [id], onDelete: Cascade)
  phoneNumber        PhoneNumber      @relation(fields: [phoneNumberId], references: [id], onDelete: Cascade)
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  order              Order?           @relation(fields: [orderId], references: [id])
  orderId            String?

  @@index([contactId, timestamp(sort: Desc)])
  @@index([userId, direction, status])
  @@index([contactId, direction, status])
  @@map("messages")
}

model MessageUnprocessed {
  id          String   @id @default(cuid())
  waMessageId String
  payload     Json
  error       String
  retryCount  Int      @default(0)
  nextRetry   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("messages_unprocessed")
}

model AutoReplyRule {
  id            String      @id @default(cuid())
  phoneNumberId String
  name          String
  triggerType   TriggerType
  triggerValue  String?
  replyMessage  String
  isActive      Boolean     @default(true)
  priority      Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  phoneNumber   PhoneNumber @relation(fields: [phoneNumberId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@map("autoreply_rules")
}

model WebhookEvent {
  id           String    @id @default(cuid())
  eventKey     String?   @unique
  type         String
  payload      Json
  processed    Boolean   @default(false)
  processedAt  DateTime?
  error        String?
  retryCount   Int       @default(0)
  nextRetry    DateTime?
  processingAt DateTime?
  createdAt    DateTime  @default(now())

  @@index([processed, nextRetry])
  @@map("webhook_events")
}

enum TriggerType {
  KEYWORD
  MESSAGE_TYPE
  TIME_BASED
  DEFAULT
}

enum PhoneNumberStatus {
  NOT_CLAIMED
  NOT_VERIFIED
  VERIFIED
  EXPIRED
}

enum MessageType {
  TEXT
  IMAGE
  DOCUMENT
  AUDIO
  VIDEO
  LOCATION
  CONTACT
  TEMPLATE
  OTHER
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
  FAILED
}

// ecommerce

model Product {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  name        String
  description String?
  sku         String?

  price    Decimal  @db.Decimal(10, 2)
  currency Currency @default(KES)

  stockQty Int @default(0)

  imageUrl String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems           OrderItem[]
  inventoryAdjustments InventoryAdjustment[]

  @@map("products")
}

enum InventoryAdjustmentSource {
  QR_SCAN
  MANUAL
}

model InventoryAdjustment {
  id             String                    @id @default(cuid())
  productId      String
  actorId        String
  quantityChange Int
  stockAfter     Int
  source         InventoryAdjustmentSource @default(MANUAL)
  idempotencyKey String                    @unique
  createdAt      DateTime                  @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  actor   User    @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt(sort: Desc)])
  @@map("inventory_adjustments")
}

model Order {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id])

  status                 OrderStatus       @default(PENDING)
  fulfillmentStatus      FulfillmentStatus @default(UNFULFILLED)
  currency               Currency          @default(KES)
  notes                  String?
  paymentLink            String?
  buyerName              String?
  buyerEmail             String?
  buyerPhone             String?
  deliveryTokenHash      String?           @unique
  deliveryTokenExpiresAt DateTime?
  deliveryConfirmedAt    DateTime?
  disputeOpenedAt        DateTime?
  disputeReason          String?
  platformFee            Decimal           @default(0) @db.Decimal(10, 2)
  payoutStatus           PayoutStatus      @default(NOT_DUE)

  total Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoice            Invoice?
  items              OrderItem[]
  payments           Payment[]
  messages           Message[]
  ledgerTransactions LedgerTransaction[]
  payout             OrderPayout?

  @@map("orders")
}

model OrderItem {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  name String

  quantity Int

  unitPrice Decimal @db.Decimal(10, 2)

  total Decimal @db.Decimal(10, 2)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

enum OrderStatus {
  PENDING
  SENT
  PARTIALLY_PAID
  PAID
  CANCELLED
}

model OrderPayout {
  id            String       @id @default(cuid())
  orderId       String       @unique
  order         Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  merchantId    String
  merchant      User         @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  amount        Decimal      @db.Decimal(10, 2)
  currency      Currency
  recipientCode String
  reference     String       @unique
  transferCode  String?
  status        PayoutStatus @default(NOT_DUE)
  requestedAt   DateTime?
  paidAt        DateTime?
  lastError     String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([status, createdAt])
  @@map("order_payouts")
}

model LedgerTransaction {
  id        String                @id @default(cuid())
  eventKey  String                @unique
  type      LedgerTransactionType
  orderId   String
  order     Order                 @relation(fields: [orderId], references: [id], onDelete: Restrict)
  lines     LedgerEntry[]
  createdAt DateTime              @default(now())

  @@index([orderId, createdAt])
  @@map("ledger_transactions")
}

model LedgerEntry {
  id            String            @id @default(cuid())
  transactionId String
  transaction   LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  account       LedgerAccount
  side          LedgerSide
  amount        Decimal           @db.Decimal(10, 2)
  currency      Currency
  createdAt     DateTime          @default(now())

  @@index([transactionId])
  @@map("ledger_entries")
}

enum InvoiceStatus {
  DRAFT // created but not sent
  PENDING // issued, awaiting payment
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

model Invoice {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id])

  invoiceNumber String @unique

  currency Currency @default(KES)

  subtotal   Decimal @db.Decimal(10, 2)
  tax        Decimal @db.Decimal(10, 2)
  discount   Decimal @default(0) @db.Decimal(10, 2)
  total      Decimal @db.Decimal(10, 2)
  amountPaid Decimal @default(0) @db.Decimal(10, 2)

  status InvoiceStatus @default(DRAFT)

  issuedAt DateTime  @default(now())
  dueDate  DateTime?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([invoiceNumber])
  @@index([dueDate])
  @@map("invoices")
}

// AI chatbot configs

model ChatbotConfig {
  id            String @id @default(cuid())
  phoneNumberId String @unique

  // Core AI Settings
  systemPrompt   String   @db.Text
  profileContext String?  @db.Text
  model          String   @default("claude-sonnet-4-20250514")
  temperature    Float    @default(0.7)
  maxTokens      Int      @default(1000)
  enabledTools   String[] @default([])

  // Behavior Settings
  isActive             Boolean  @default(true)
  fallbackToHuman      Boolean  @default(true)
  humanHandoffKeywords String[] // ["agent", "human", "help"]

  // Response Settings
  responseDelay   Int?    @default(1000) // ms delay to seem more human
  typingIndicator Boolean @default(true)

  // Context & Memory
  conversationHistory Int @default(10) // last N messages to include
  resetContextAfter   Int @default(30) // minutes of inactivity

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  phoneNumber   PhoneNumber           @relation(fields: [phoneNumberId], references: [id], onDelete: Cascade)
  conversations ChatbotConversation[]

  @@map("chatbot_configs")
}

enum AgentRunStatus {
  SUCCEEDED
  FAILED
}

model AgentRun {
  id            String         @id @default(cuid())
  userId        String
  phoneNumberId String
  contactId     String?
  provider      String
  model         String
  status        AgentRunStatus
  isPreview     Boolean        @default(false)
  durationMs    Int?
  errorCode     String?
  createdAt     DateTime       @default(now())

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  phoneNumber PhoneNumber     @relation(fields: [phoneNumberId], references: [id], onDelete: Cascade)
  contact     Contact?        @relation(fields: [contactId], references: [id], onDelete: SetNull)
  toolCalls   AgentToolCall[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([phoneNumberId, status, createdAt(sort: Desc)])
  @@map("agent_runs")
}

model AgentToolCall {
  id                String   @id @default(cuid())
  runId             String
  capability        String
  capabilityVersion String
  inputSummary      Json
  outputSummary     Json?
  succeeded         Boolean
  durationMs        Int
  createdAt         DateTime @default(now())

  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, createdAt])
  @@map("agent_tool_calls")
}

model MessageQuota {
  id          String   @id @default(cuid())
  userId      String
  periodStart DateTime
  periodEnd   DateTime
  used        Int      @default(0)
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, periodStart])
  @@index([periodEnd])
  @@map("message_quotas")
}

model ChatbotConversation {
  id              String @id @default(cuid())
  chatbotConfigId String
  contactId       String

  // Conversation State
  context          Json // Store conversation context/memory
  messageCount     Int     @default(0)
  isActive         Boolean @default(true)
  handedOffToHuman Boolean @default(false)

  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  chatbotConfig ChatbotConfig @relation(fields: [chatbotConfigId], references: [id], onDelete: Cascade)
  contact       Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([chatbotConfigId, contactId])
  @@index([isActive])
  @@map("chatbot_conversations")
}

// Optional: Store prompt templates for reuse

model PromptTemplate {
  id          String  @id @default(cuid())
  name        String
  description String?
  content     String  @db.Text
  category    String? // "customer_support", "sales", "general"
  isPublic    Boolean @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("prompt_templates")
}

// Contact Us

model ContactUs {
  id        String        @id @default(cuid())
  email     String
  name      String?
  subject   String?
  message   String        @db.Text
  phone     String?
  company   String?
  status    ContactStatus @default(PENDING)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([email])
  @@index([status])
  @@index([createdAt])
  @@map("contact_us")
}

enum ContactStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
  SPAM
}
